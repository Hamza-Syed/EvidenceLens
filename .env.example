# Set these environment variables before starting the backend (no API key needed).
# This file is a reference; the backend reads process environment, not .env files.
EVIDENCELENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: absolute path to a writable model weight cache; default is .cache/fastembed.
# EVIDENCELENS_EMBEDDING_CACHE_DIR=C:/path/to/model-cache
EVIDENCELENS_EMBEDDING_THREADS=2
EVIDENCELENS_RETRIEVAL_TOP_K=5
EVIDENCELENS_RETRIEVAL_MIN_SIMILARITY=0.45
EVIDENCELENS_CHUNK_MAX_CHARS=1000
EVIDENCELENS_CHUNK_OVERLAP_CHARS=150
# Local chat-completions endpoint. Use scripts/prepare_local_verifier.py first.
EVIDENCELENS_VERIFIER_MODE=model
EVIDENCELENS_VERIFIER_BASE_URL=http://127.0.0.1:8081/v1
EVIDENCELENS_VERIFIER_MODEL=evidencelens-verifier
# Optional for a hosted compatible endpoint. Never commit real keys.
EVIDENCELENS_VERIFIER_API_KEY=
EVIDENCELENS_VERIFIER_TIMEOUT_SECONDS=120
EVIDENCELENS_VERIFIER_MAX_INPUT_CHARS=16000
# Logs UUIDs, ranks, similarity, and verdicts only; never document/claim text.
EVIDENCELENS_DEBUG_PIPELINE=false
BACKEND_URL=http://127.0.0.1:8000
